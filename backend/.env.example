DATABASE_URL="file:./dev.db"
PORT=4000

# Провайдер генерации: cursor | openai. Если не задан — определяется по ключам:
# CURSOR_API_KEY (или ключ вида crsr_… в OPENAI_API_KEY) → cursor, иначе openai
LLM_PROVIDER=""

# Ключ Cursor API (Dashboard → Integrations) и модель
CURSOR_API_KEY=""
CURSOR_MODEL="composer-2.5"

# Ключ OpenAI для генерации маршрутов
OPENAI_API_KEY=""
# Модель: gpt-4o-mini (по умолчанию) или gpt-4o
OPENAI_MODEL="gpt-4o-mini"
# 1 — демо-режим без обращения к OpenAI (готовый маршрут по Риму)
OPENAI_MOCK=0

# Геокодер OpenStreetMap Nominatim (0 — отключить уточнение координат)
GEOCODER_ENABLED=1
# Политика Nominatim требует User-Agent с контактом приложения
NOMINATIM_USER_AGENT="AI-Travel-Planner/0.1 (your-email@example.com)"

# Свой OSRM со всеми профилями. Пусто — авто на router.project-osrm.org,
# пешком и велосипед на routing.openstreetmap.de: демо-сервер OSRM
# отвечает на foot и bike автомобильным графом. Только для локальной разработки.
OSRM_URL=""

# Общественный транспорт (Transitous). Пусто — api.transitous.org.
# Остановки и линии из открытых расписаний GTFS. Только для локальной разработки.
TRANSIT_URL=""
